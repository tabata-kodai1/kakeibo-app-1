# ローカル開発用。本番用の Dockerfile は RAILS_ENV=production かつ
# BUNDLE_WITHOUT=development で、コードをイメージに焼き込む作りになっている。
# 開発ではソースをバインドマウントし、RSpec や RuboCop などの development の
# gem も要るため、別のイメージとして用意する（本番用はそのまま EC2 で使う）。
ARG RUBY_VERSION=3.3.12
FROM docker.io/library/ruby:$RUBY_VERSION-slim

WORKDIR /rails

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential default-libmysqlclient-dev default-mysql-client git libyaml-dev pkg-config && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

ENV BUNDLE_PATH="/usr/local/bundle"

COPY Gemfile Gemfile.lock ./
RUN bundle install

EXPOSE 3000
CMD ["./bin/rails", "server", "-b", "0.0.0.0"]
