# docker compose が読み込む環境変数のひな形。
# このファイルをコピーして .env を作る（.env は Git にコミットしない / N-11）。
#
#   cp .env.example .env

# MySQL コンテナの初期化に使う値
MYSQL_ROOT_PASSWORD=kakeibo
MYSQL_DATABASE=kakeibo_development

# Rails の接続先。スキームは mysql2://（mysql:// ではない / docs/tech-stack.md）
DATABASE_URL=mysql2://root:kakeibo@db:3306/kakeibo_development
